# Copy to .env and fill in. .env is gitignored; this file is not — never put a
# real value here. Every setting has a default in src/config.js, so the only
# strictly required one is OPENROUTER_API_KEY (and AGENT_TOKEN off localhost).

# --- LLM ---------------------------------------------------------------------
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-oss-20b:free
# AI_TIMEOUT=90000
# AI_MAX_RETRIES=3

# --- Browser -----------------------------------------------------------------
HEADLESS=false
# SLOW_MO=150
# TIMEOUT=30000            # element lookups
# NAVIGATION_TIMEOUT=60000  # page.goto only; a cold load here measures ~19s
# SETTLE_MS=700          # pause after each action; raise for slow SPAs

# --- Agent -------------------------------------------------------------------
# MAX_STEPS=60
# MAX_RETRIES=3
# CONFIDENCE_THRESHOLD=0.8
# USE_CACHE=true
# VISION=false           # costs image tokens; DOM path is the default

# --- Job source --------------------------------------------------------------
# JOB_SOURCE=file        # file | http
# JOB_URL=               # n8n webhook, when JOB_SOURCE=http
# JOB_TIMEOUT=30000

# --- Server (inbound from n8n) -----------------------------------------------
# PORT=3000
# HOST=127.0.0.1         # 0.0.0.0 to reach it from an n8n container
AGENT_TOKEN=             # required whenever HOST is not localhost
# CONCURRENCY=2
# MAX_QUEUE=50

# --- Server (outbound callback to n8n) ---------------------------------------
# CALLBACK_TOKEN=        # deliberately NOT the same as AGENT_TOKEN
# CALLBACK_HOSTS=        # comma-separated allowlist; empty means any http(s) host

# --- Deploy tool -------------------------------------------------------------
# N8N_URL=
# N8N_API_KEY=

# --- Job variables -----------------------------------------------------------
# Referenced from a job file as "${PA_USERNAME}". Add one line per credential.
PA_USERNAME=
PA_PASSWORD=
